# API Configuration
# Copy this file to .env and adjust values for your environment

# API Base URL
# Development (local)
API_BASE_URL=http://localhost:3000/api

# Development (emulator/device on same network)
# API_BASE_URL=http://192.168.1.x:3000/api

# Production
# API_BASE_URL=https://api.obsense.com/api
